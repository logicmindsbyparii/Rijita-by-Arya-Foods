{
  "name": "rijita-by-aryafoods",
  "version": "1.0.0",
  "private": true,
  "description": "Premium Ecommerce Platform for RIJITA by Arya Foods",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "cd frontend/client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "build": "npm run build:server && npm run build:client",
    "build:client": "cd frontend/client && npm run build",
    "build:server": "cd server && npm run build",
    "install:all": "cd frontend/client && npm install && cd ../../server && npm install",
    "start": "concurrently \"npm run start:server\" \"npm run start:client\"",
    "start:client": "cd frontend/client && npm start",
    "start:server": "cd server && npm start",
    "tunnel:client": "npx ngrok http 3000",
    "tunnel:server": "npx ngrok http 5001",
    "tunnel:lt:client": "npx localtunnel --port 3000"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
