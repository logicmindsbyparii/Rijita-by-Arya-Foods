# ─── Server Environment Configuration ──────────────────────
NODE_ENV=development
PORT=5001

# ─── MongoDB ────────────────────────────────────────────────
# Get your free MongoDB Atlas URI at https://www.mongodb.com/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/rijita?retryWrites=true&w=majority

# ─── JWT ────────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_REFRESH_SECRET=change-this-to-another-strong-random-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── Client ─────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ─── WhatsApp (OpenWA) ──────────────────────────────────────
# Business WhatsApp number (with country code, no +)
WHATSAPP_NUMBER=919904459998
# Admin phone for order notifications (with country code, no +)
ADMIN_PHONE=919904459998
# OpenWA self-hosted gateway URL (default port is 2785)
OPENWA_API_URL=http://localhost:2785
OPENWA_API_KEY=
# OpenWA WhatsApp session name (must match the session created in the container)
WHATSAPP_SESSION_ID=rijita-bot
# ⚠️ Get your WhatsApp session QR code:
#   1. Run: docker-compose up -d openwa
#   2. Check logs: docker logs -f rijita-whatsapp
#   3. Scan the QR code with WhatsApp mobile app → Linked Devices
#   4. Once connected, messages will be sent automatically

# ─── Email (Nodemailer) ──────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=admin@rijita.com

# ─── Shiprocket ─────────────────────────────────────────────
# Create an API user at Shiprocket → Settings → API → Configure
# (this must be an API-only user, NOT your dashboard login)
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Nickname of the pickup address registered in Shiprocket → Settings → Pickup Addresses
SHIPROCKET_PICKUP_LOCATION=Primary
# Pincode of that pickup address — required for rate/serviceability quotes at checkout
SHIPROCKET_PICKUP_PINCODE=
# Optional: custom channel id (leave blank to use the default API channel)
SHIPROCKET_CHANNEL_ID=
# Shared secret for the status webhook — paste the same value into
# Shiprocket → Settings → API → Webhooks as the "x-api-key" token.
# Webhook URL: https://<your-server>/api/shipping/webhook/shiprocket
SHIPROCKET_WEBHOOK_TOKEN=
# Push each order to Shiprocket automatically (COD on placement, prepaid once paid)
# instead of pushing by hand from the admin Orders page.
# Also togglable at runtime under admin Settings → Shipping.
SHIPROCKET_AUTO_CREATE=false
# Default parcel dimensions in cm and packaging tare weight in kg
SHIPROCKET_PACKAGE_LENGTH=20
SHIPROCKET_PACKAGE_BREADTH=15
SHIPROCKET_PACKAGE_HEIGHT=10
SHIPROCKET_PACKAGING_WEIGHT=0.1
# Fallback polling interval for shipments (webhooks are the primary channel)
SHIPROCKET_TRACKING_SYNC_MINUTES=30

# ─── Upload ─────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=logs
