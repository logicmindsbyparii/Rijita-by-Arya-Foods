# ─── Client Environment Configuration ──────────────────────

# What the BROWSER calls. Keep this relative so requests stay same-origin and
# the backend's SameSite=Lax refresh cookie survives; Next.js rewrites /api and
# /uploads through to API_ORIGIN.
NEXT_PUBLIC_API_URL=/api

# Where the rewrite proxies to. Server-side only — never exposed to the client.
# Local:      http://localhost:5001
# Production: https://rijita-by-arya-foods.onrender.com
API_ORIGIN=http://localhost:5001

# Public URL of this site (used for canonical links and the sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_OPENWA_API_URL=http://localhost:2785
