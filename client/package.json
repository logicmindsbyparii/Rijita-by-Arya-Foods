    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.2.5",
    "happy-dom": "^20.10.6",
    "jsdom": "^27.0.1",
    "postcss": "^8.4.41",
    "prettier": "^3.9.5",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.9",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
